# ============================================================
# SUNUSCORE - Variables d'environnement (exemple)
# Copier ce fichier en .env et adapter les valeurs.
# NE JAMAIS COMMITER .env sur GitHub.
# ============================================================

APP_NAME="SUNUSCORE"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/sunuscore/public
APP_TIMEZONE=Africa/Dakar

# Base de donnees
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sunuscore
DB_USER=sunuscore_user
DB_PASS=
DB_CHARSET=utf8mb4

# Securite
SESSION_NAME=SUNUSCORE_SESSID
SESSION_LIFETIME=7200
CSRF_TOKEN_NAME=_csrf_token